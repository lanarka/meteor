program "tv - a Turbo Vision style text-mode demo: menu bar (File / Help) with dropdowns, Welcome and About dialogs, drop shadows and a semi-transparent mouse cursor. Mouse only (left button). Everything is redrawn each frame (immediate-mode GUI) (port of tv.quartz, uses lib/tui and lib/input)";
import "../lib/tui.obj";
import "../lib/input.obj";

const BLACK = 0xFF000000;
const WHITE = 0xFFFFFFFF;
const SILVER = 0xFFC0C0C0;
const HOT = 0xFF0000FF;
const DLG_BG = 0xFFAA0000;

let ui_state: u32 = 1;
let menu_active: u32;
/// the text screen keeps what was drawn: the picture is made again only when the mouse moved or was clicked
let redraw: u32;
let last_x: i32;
let last_y: i32;
let s_file: u8[] = "File";
let s_help: u8[] = "Help";
let s_reboot: u8[] = "Reboot";
let s_quit: u8[] = "Quit";
let s_about: u8[] = "About";
let s_btnok: u8[] = "[ OK ]";
let s_w_title: u8[] = "Welcome";
let s_w_l1: u8[] = "Welcome to the Quartz Turbo Vision demo!";
let s_w_l2: u8[] = "This is a text-mode interface, just like";
let s_w_l3: u8[] = "the ones common in 1980s computing.";
let s_a_title: u8[] = "About";
let s_a_l1: u8[] = "Quartz Turbo Vision Demo";
let s_a_l2: u8[] = "Version 1.0";
let s_a_l3: u8[] = "Written in Meteor";
let s_a_l4: u8[] = "(c) 2026";

/// is the mouse cell inside the rectangle?
function hit(x: u32, y: u32, w: u32, h: u32): u32 {
    return mouse_in(i32(x), i32(y), i32(w), i32(h));
}

/// a menu entry: highlighted when the mouse is over its row, otherwise with a red hot letter
function menu_item(x: u32, y: u32, w: u32, text_x: u32, label: u32, hot_letter: u32) {
    if (hit(x, y, w, 1) == 1) {
        tui_fill(x, y, w, 1, 32, WHITE, BLACK);
        tui_str(text_x, y, label, WHITE, BLACK);
    } else {
        tui_str(text_x, y, label, BLACK, SILVER);
        text_put(text_x, y, hot_letter, HOT, SILVER);
    }
}

function render_menubar() {
    tui_fill(0, 0, 80, 1, 32, BLACK, SILVER);
    if (menu_active == 1) {
        tui_fill(1, 0, 6, 1, 32, WHITE, BLACK);
        tui_str(2, 0, addr(s_file), WHITE, BLACK);
    } else {
        tui_str(2, 0, addr(s_file), BLACK, SILVER);
        text_put(2, 0, 70, HOT, SILVER);
    }
    if (menu_active == 2) {
        tui_fill(9, 0, 6, 1, 32, WHITE, BLACK);
        tui_str(10, 0, addr(s_help), WHITE, BLACK);
    } else {
        tui_str(10, 0, addr(s_help), BLACK, SILVER);
        text_put(10, 0, 72, HOT, SILVER);
    }
}

function render_file_menu() {
    tui_frame(1, 1, 14, 4, TUI_FRAME_DOUBLE, BLACK, SILVER);
    tui_fill(2, 2, 12, 2, 32, BLACK, SILVER);
    tui_shadow(1, 1, 14, 4);
    menu_item(1, 2, 14, 3, addr(s_reboot), 82);
    menu_item(1, 3, 14, 3, addr(s_quit), 81);
}

function render_help_menu() {
    tui_frame(9, 1, 14, 3, TUI_FRAME_DOUBLE, BLACK, SILVER);
    tui_fill(10, 2, 12, 1, 32, BLACK, SILVER);
    tui_shadow(9, 1, 14, 3);
    menu_item(9, 2, 14, 11, addr(s_about), 65);
}

/// [ OK ] button of a dialog, inverted while the mouse is over it
function ok_button(y: u32) {
    if (hit(36, y, 8, 1) == 1) {
        tui_fill(36, y, 8, 1, 32, BLACK, WHITE);
        tui_str(37, y, addr(s_btnok), BLACK, WHITE);
    } else {
        tui_str(37, y, addr(s_btnok), WHITE, DLG_BG);
    }
}

function dialog_frame(x: u32, y: u32, w: u32, h: u32, title: u32) {
    tui_frame(x, y, w, h, TUI_FRAME_DOUBLE, WHITE, DLG_BG);
    tui_fill(x + 1, y + 1, w - 2, h - 2, 32, WHITE, DLG_BG);
    tui_str_center(x, w, y, title, COLOR_YELLOW, DLG_BG);
}

function dialog_line(x: u32, y: u32, w: u32, row: u32, s: u32) {
    tui_str_center(x, w, y + row, s, WHITE, DLG_BG);
}

function render_welcome_dialog() {
    dialog_frame(18, 10, 44, 9, addr(s_w_title));
    dialog_line(18, 10, 44, 2, addr(s_w_l1));
    dialog_line(18, 10, 44, 3, addr(s_w_l2));
    dialog_line(18, 10, 44, 4, addr(s_w_l3));
    ok_button(16);
    tui_shadow(18, 10, 44, 9);
}

function render_about_dialog() {
    dialog_frame(20, 10, 40, 10, addr(s_a_title));
    dialog_line(20, 10, 40, 2, addr(s_a_l1));
    dialog_line(20, 10, 40, 3, addr(s_a_l2));
    dialog_line(20, 10, 40, 4, addr(s_a_l3));
    dialog_line(20, 10, 40, 5, addr(s_a_l4));
    ok_button(17);
    tui_shadow(20, 10, 40, 10);
}

function render_frame() {
    /// the desktop
    tui_fill(0, 1, 80, 29, TUI_SHADE, COLOR_GRAY, 0xFFAAAA00);
    render_menubar();
    if (menu_active == 1) {
        render_file_menu();
    } else if (menu_active == 2) {
        render_help_menu();
    }
    if (ui_state == 1) {
        render_welcome_dialog();
    } else if (ui_state == 2) {
        render_about_dialog();
    }
    /// last layer: a semi-transparent white block over the cell under the mouse
    tui_cursor(u32(mouse_x), u32(mouse_y));
}

function handle_click() {
    if (ui_state == 1) {
        if (hit(36, 16, 8, 1) == 1) {
            ui_state = 0;
        }
    } else if (ui_state == 2) {
        if (hit(36, 17, 8, 1) == 1) {
            ui_state = 0;
        }
    } else if (menu_active == 0) {
        if (hit(1, 0, 6, 1) == 1) {
            menu_active = 1;
        } else if (hit(9, 0, 6, 1) == 1) {
            menu_active = 2;
        }
    } else if (menu_active == 1) {
        if (hit(1, 0, 6, 1) == 1) {
            menu_active = 0;
        } else if (hit(9, 0, 6, 1) == 1) {
            menu_active = 2;
        } else if (hit(1, 2, 14, 1) == 1) {
            /// File > Reboot: cold restart of the VM
            sys_reboot();
        } else if (hit(1, 3, 14, 1) == 1) {
            /// File > Quit
            halt;
        } else {
            menu_active = 0;
        }
    } else {
        /// help menu is open
        if (hit(9, 0, 6, 1) == 1) {
            menu_active = 0;
        } else if (hit(1, 0, 6, 1) == 1) {
            menu_active = 1;
        } else if (hit(9, 2, 14, 1) == 1) {
            menu_active = 0;
            ui_state = 2;
        } else {
            menu_active = 0;
        }
    }
}

/// init
bell();
ui_state = 1;
redraw = 1;
/// the mouse reports text-cell coordinates for the whole run - stage that once
mouse_mode(1);
loop {
    mouse_poll();
    if (mouse_clicked() == 1) {
        handle_click();
        redraw = 1;
    }
    if (mouse_x != last_x || mouse_y != last_y) {
        redraw = 1;
    }
    if (redraw == 1) {
        render_frame();
        redraw = 0;
        last_x = mouse_x;
        last_y = mouse_y;
    }
    sys_vsync();
}
