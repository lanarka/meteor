program "test - a self-test of the VM instructions: every test computes a value and compares it with the expected result. Prints the first failed test number, or 0 when all tests pass. Arithmetic is written with Meteor operators (they compile to the instruction under test); the checks of jump, mov, inc/dec and push/pop instructions are plain assembler (port of test.quartz)";
ram(start: 0x1000);

let status: i32;
let cell8: u8 at 100;
let cell64: i64 at 200;
let ptr: u32;
let i8_a: i8;
let i8_b: i8;
let i8_r: i8;
let i16_a: i16;
let i32_a: i32;
let i32_b: i32;
let i32_r: i32;
let u8_a: u8;
let u8_b: u8;
let u8_r: u8;
let u16_a: u16;
let u16_b: u16;
let u16_r: u16;
let u32_a: u32;
let u32_b: u32;
let u32_r: u32;
let i64_a: i64;
let i64_b: i64;
let i64_r: i64;
let u64_a: u64;
let u64_b: u64;
let u64_r: u64;
let f32_a: f32;
let f32_b: f32;
let f32_r: f32;
let f64_a: f64;
let f64_b: f64;
let f64_r: f64;

function square(x: i32): i32 {
    return x * x;
}

asm ["nop"];
/// test 0: NOP - just advances the PC, checks nothing
/// Section A: movi / debug for all 10 types (tests 1-10)
i8_a = -100;
debug(i8_a);
if (i8_a != -100) {
    status = 1;
    goto fail;
}
i16_a = -30000;
debug(i16_a);
if (i16_a != -30000) {
    status = 2;
    goto fail;
}
i32_a = -2000000000;
debug(i32_a);
if (i32_a != -2000000000) {
    status = 3;
    goto fail;
}
u8_a = 200;
debug(u8_a);
if (u8_a != 200) {
    status = 4;
    goto fail;
}
u16_a = 60000;
debug(u16_a);
if (u16_a != 60000) {
    status = 5;
    goto fail;
}
u32_a = 4000000000;
debug(u32_a);
if (u32_a != 4000000000) {
    status = 6;
    goto fail;
}
i64_a = -9000000000000000000;
debug(i64_a);
if (i64_a != -9000000000000000000) {
    status = 7;
    goto fail;
}
u64_a = 0xf9ccd8a1c5080000;
debug(u64_a);
if (u64_a != 0xf9ccd8a1c5080000) {
    status = 8;
    goto fail;
}
f32_a = 123.5;
debug(f32_a);
if (f32_a != 123.5) {
    status = 9;
    goto fail;
}
f64_a = 100.25;
debug(f64_a);
if (f64_a != 100.25) {
    status = 10;
    goto fail;
}
/// Section B: MOV (raw bit copy) - the register copy itself is the test, so plain assembler
asm [
    "movi i32 #0 777", "mov #1 #0", "cmpi i32 #1 777", "jz t11", "movi i32 #0 11",
    "store i32 {status} #0", "jmp fail", "t11:"
];
/// Section C: ADD (tests 12-15) - wrapping and real 64-bit width
i32_a = 5;
i32_b = 3;
i32_r = i32_a + i32_b;
if (i32_r != 8) {
    status = 12;
    goto fail;
}
u8_a = 250;
u8_b = 10;
u8_r = u8_a + u8_b;
if (u8_r != 4) {
    status = 13;
    goto fail;
}
f32_a = 3.5;
f32_b = 1.25;
f32_r = f32_a + f32_b;
if (f32_r != 4.75) {
    status = 14;
    goto fail;
}
i64_a = 5000000000;
i64_b = 3000000000;
i64_r = i64_a + i64_b;
if (i64_r != 8000000000) {
    status = 15;
    goto fail;
}
/// Section D: SUB / SUBI (tests 16-18)
i32_a = 10;
i32_b = 3;
i32_r = i32_a - i32_b;
if (i32_r != 7) {
    status = 16;
    goto fail;
}
u16_a = 0;
u16_r = u16_a - 1;
if (u16_r != 65535) {
    status = 17;
    goto fail;
}
f64_a = 5.75;
f64_b = 2.25;
f64_r = f64_a - f64_b;
if (f64_r != 3.5) {
    status = 18;
    goto fail;
}
/// Section E: MUL (tests 19-21)
i32_a = 6;
i32_b = 7;
i32_r = i32_a * i32_b;
if (i32_r != 42) {
    status = 19;
    goto fail;
}
u8_a = 100;
u8_b = 3;
u8_r = u8_a * u8_b;
if (u8_r != 44) {
    status = 20;
    goto fail;
}
f32_a = 2.5;
f32_b = 4.0;
f32_r = f32_a * f32_b;
if (f32_r != 10.0) {
    status = 21;
    goto fail;
}
/// Section F: DIV - unsigned, signed (truncates toward zero), float (tests 22-24)
u32_a = 10;
u32_b = 3;
u32_r = u32_a / u32_b;
if (u32_r != 3) {
    status = 22;
    goto fail;
}
i32_a = -10;
i32_b = 3;
i32_r = i32_a / i32_b;
if (i32_r != -3) {
    status = 23;
    goto fail;
}
f64_a = 10.0;
f64_b = 4.0;
f64_r = f64_a / f64_b;
if (f64_r != 2.5) {
    status = 24;
    goto fail;
}
/// Section G: MOD (tests 25-27)
u32_a = 10;
u32_b = 3;
u32_r = u32_a % u32_b;
if (u32_r != 1) {
    status = 25;
    goto fail;
}
i32_a = -10;
i32_b = 3;
i32_r = i32_a % i32_b;
if (i32_r != -1) {
    status = 26;
    goto fail;
}
f64_a = 7.5;
f64_b = 2.0;
f64_r = f64_a % f64_b;
if (f64_r != 1.5) {
    status = 27;
    goto fail;
}
/// Section H: AND / OR / XOR (tests 28-30), 12 = 0b1100, 10 = 0b1010
u8_a = 12;
u8_b = 10;
u8_r = u8_a & u8_b;
if (u8_r != 8) {
    status = 28;
    goto fail;
}
u8_a = 12;
u8_b = 10;
u8_r = u8_a | u8_b;
if (u8_r != 14) {
    status = 29;
    goto fail;
}
u8_a = 12;
u8_b = 10;
u8_r = u8_a ^ u8_b;
if (u8_r != 6) {
    status = 30;
    goto fail;
}
/// Section I: SHL / SHR - logical for unsigned, arithmetic for signed (tests 31-33)
u8_a = 1;
u8_b = 3;
u8_r = u8_a << u8_b;
if (u8_r != 8) {
    status = 31;
    goto fail;
}
u8_a = 128;
u8_b = 3;
u8_r = u8_a >> u8_b;
if (u8_r != 16) {
    status = 32;
    goto fail;
}
i8_a = -8;
i8_b = 1;
i8_r = i8_a >> i8_b;
if (i8_r != -4) {
    status = 33;
    goto fail;
}
/// Section J: ADDI / SUBI - a constant operand gives the immediate forms (tests 34-36)
i32_a = 5;
i32_r = i32_a + 10;
if (i32_r != 15) {
    status = 34;
    goto fail;
}
u16_a = 5;
u16_r = u16_a - 10;
if (u16_r != 65531) {
    status = 35;
    goto fail;
}
u64_a = 0;
u64_r = u64_a - 1;
if (u64_r != 0xFFFFFFFFFFFFFFFF) {
    status = 36;
    goto fail;
}
/// Section K: INC / DEC (tests 37-38) - Meteor's inc/dec statements emit addi, so these two are plain assembler
asm [
    "movi i32 #0 41", "inc i32 #0", "cmpi i32 #0 42", "jz t37", "movi i32 #0 37",
    "store i32 {status} #0", "jmp fail", "t37:", "movi f32 #0 5.5", "dec f32 #0", "cmpi f32 #0 4.5",
    "jz t38", "movi i32 #0 38", "store i32 {status} #0", "jmp fail", "t38:"
];
/// Section L: NOT (test 39): ~15 truncated to u8 = 240
u8_a = 15;
u8_r = ~u8_a;
if (u8_r != 240) {
    status = 39;
    goto fail;
}
/// Section M: conditional jumps JZ/JNZ/JG/JL/JGE/JLE, each with a taken and a not-taken case (tests 40-51).
/// The jump instruction itself is under test, so this is plain assembler.
asm [
    "movi i32 #0 5", "cmpi i32 #0 5", "jz m40_ok", "movi i32 #0 40", "store i32 {status} #0",
    "jmp fail", "m40_ok:", "movi i32 #0 5", "cmpi i32 #0 6", "jz m41_bad", "jmp m41_ok", "m41_bad:",
    "movi i32 #0 41", "store i32 {status} #0", "jmp fail", "m41_ok:", "movi i32 #0 5",
    "cmpi i32 #0 6", "jnz m42_ok", "movi i32 #0 42", "store i32 {status} #0", "jmp fail", "m42_ok:",
    "movi i32 #0 5", "cmpi i32 #0 5", "jnz m43_bad", "jmp m43_ok", "m43_bad:", "movi i32 #0 43",
    "store i32 {status} #0", "jmp fail", "m43_ok:", "movi i32 #0 10", "cmpi i32 #0 5", "jg m44_ok",
    "movi i32 #0 44", "store i32 {status} #0", "jmp fail", "m44_ok:", "movi i32 #0 5",
    "cmpi i32 #0 5", "jg m45_bad", "jmp m45_ok", "m45_bad:", "movi i32 #0 45",
    "store i32 {status} #0", "jmp fail", "m45_ok:", "movi i32 #0 3", "cmpi i32 #0 8", "jl m46_ok",
    "movi i32 #0 46", "store i32 {status} #0", "jmp fail", "m46_ok:", "movi i32 #0 8",
    "cmpi i32 #0 8", "jl m47_bad", "jmp m47_ok", "m47_bad:", "movi i32 #0 47",
    "store i32 {status} #0", "jmp fail", "m47_ok:", "movi i32 #0 5", "cmpi i32 #0 5", "jge m48_ok",
    "movi i32 #0 48", "store i32 {status} #0", "jmp fail", "m48_ok:", "movi i32 #0 3",
    "cmpi i32 #0 8", "jge m49_bad", "jmp m49_ok", "m49_bad:", "movi i32 #0 49",
    "store i32 {status} #0", "jmp fail", "m49_ok:", "movi i32 #0 5", "cmpi i32 #0 5", "jle m50_ok",
    "movi i32 #0 50", "store i32 {status} #0", "jmp fail", "m50_ok:", "movi i32 #0 9",
    "cmpi i32 #0 4", "jle m51_bad", "jmp m51_ok", "m51_bad:", "movi i32 #0 51",
    "store i32 {status} #0", "jmp fail", "m51_ok:"
];
/// Section N: CALL / RET (test 52)
i32_a = 6;
i32_r = square(i32_a);
if (i32_r != 36) {
    status = 52;
    goto fail;
}
/// Section O: PUSH / POP are LIFO (tests 53-55) - plain assembler
asm [
    "movi i32 #0 1", "movi i32 #1 2", "movi i32 #2 3", "push #0", "push #1", "push #2", "pop #3",
    "pop #4", "pop #5", "cmpi i32 #3 3", "jz t53", "movi i32 #0 53", "store i32 {status} #0",
    "jmp fail", "t53:", "cmpi i32 #4 2", "jz t54", "movi i32 #0 54", "store i32 {status} #0",
    "jmp fail", "t54:", "cmpi i32 #5 1", "jz t55", "movi i32 #0 55", "store i32 {status} #0",
    "jmp fail", "t55:"
];
/// Section P: LOAD/STORE with a direct address (cell8 @100, cell64 @200) and LOADR/STORER through a register (tests 56-58)
cell8 = 222;
u8_r = cell8;
if (u8_r != 222) {
    status = 56;
    goto fail;
}
cell64 = -123456789012345;
i64_r = cell64;
if (i64_r != -123456789012345) {
    status = 57;
    goto fail;
}
ptr = 300;
poke(ptr, u32, 4000000000);
u32_r = peek(ptr, u32);
if (u32_r != 4000000000) {
    status = 58;
    goto fail;
}
/// Section Q: RND - manual check, the value must be in 0..99
debug(rnd(100));
/// result: 0 = ALL TESTS PASSED, otherwise the number of the first failed test
status = 0;
debug(status);
goto end;
label fail;
debug(status);
label end;
