program "piano - the computer keyboard as a piano. White keys: A S D F G H J K L (C4 .. D5), black keys: W E T Y U O P. The number keys 1 - 4 pick the sound: square, sine, triangle, sawtooth. The keys on screen light up while you hold them. (lib/audio, lib/gfx, lib/gtext, lib/input)";
import "../lib/audio.obj";
import "../lib/gtext.obj";
import "../lib/input.obj";
import "../lib/str.obj";
/// lib/gtext keeps a glyph cache of ~66 KB, the sound buffer takes 16 KB
ram(size: 262144);

const X0 = 32;
const WHITE_W = 64;
const WHITE_H = 230;
const BLACK_W = 40;
const BLACK_H = 140;
const KEYS_TOP = 150;

/// white keys: computer key, MIDI note
let white_key: u16[9] = [kb.KEY_A, kb.KEY_S, kb.KEY_D, kb.KEY_F, kb.KEY_G, kb.KEY_H, kb.KEY_J, kb.KEY_K, kb.KEY_L];
let white_note: u8[9] = [60, 62, 64, 65, 67, 69, 71, 72, 74];
let white_name: u8[] = "ASDFGHJKL";
/// black keys sit between two white keys: the index of the white key on their left, computer key, MIDI note
let black_left: u8[7] = [0, 1, 3, 4, 5, 7, 8];
let black_key: u16[7] = [kb.KEY_W, kb.KEY_E, kb.KEY_T, kb.KEY_Y, kb.KEY_U, kb.KEY_O, kb.KEY_P];
let black_note: u8[7] = [61, 63, 66, 68, 70, 73, 75];
let black_name: u8[] = "WETYUOP";
let wave_names: u8[] = "square\0sine\0triangle\0sawtooth";
let wave: u32 = AUDIO_SINE;
let playing: u32;
let s_title: u8[] = "PIANO";
let s_wave: u8[] = "Sound (1-4): ";
let s_white_labels: u8[] = "ASDFGHJKL";
let s_black_labels: u8[] = "WETYUOP";
let i: u32;
let n: u32;
let w: u32;

function play(note: u32) {
    audio_reset();
    audio_tone(audio_note_freq(note), 350, wave);
    audio_play();
}

function wave_name(): u32 {
    let a: u32;
    let k: u32;

    a = addr(wave_names);
    for (k of 0 .. wave) {
        a = a + str_len(a) + 1;
    }
    return a;
}

const BG = 0xFF302018;

/// the parts of the picture that never change: drawn once (the 3x title costs a few hundred thousand
/// instructions - more than one frame has - so it must not be part of what is redrawn on every key)
function draw_static() {
    gfx_fill_rect(0, 0, 640, 480, BG);
    gtext_scale = 3;
    gtext_center(0, 640, 20, addr(s_title), COLOR_YELLOW);
    gtext_scale = 1;
    gtext(32, 100, addr(s_wave), COLOR_GRAY);
}

/// the name of the sound
function draw_wave() {
    gfx_fill_rect(144, 98, 200, 20, BG);
    gtext(144, 100, wave_name(), COLOR_WHITE);
}

/// the keys, lit while they are held
function draw_keys() {
    let k: u32;
    let x: i32;
    let color: u32;

    for (k of 0 .. 9) {
        x = X0 + i32(k) * WHITE_W;
        color = COLOR_WHITE;
        if (kbd_down(u32(white_key[k])) == 1) {
            color = 0xFF70D0FF;
        }
        gfx_fill_rect(x, KEYS_TOP, WHITE_W - 2, WHITE_H, color);
        gtext_char(x + 28, KEYS_TOP + WHITE_H - 24, u32(white_name[k]), COLOR_DARK_GRAY, 0);
    }
    for (k of 0 .. 7) {
        x = X0 + (i32(black_left[k]) + 1) * WHITE_W - BLACK_W / 2 - 1;
        color = COLOR_BLACK;
        if (kbd_down(u32(black_key[k])) == 1) {
            color = 0xFF2060E0;
        }
        gfx_fill_rect(x, KEYS_TOP, BLACK_W, BLACK_H, color);
        gtext_char(x + 16, KEYS_TOP + BLACK_H - 24, u32(black_name[k]), COLOR_GRAY, 0);
    }
}

draw_static();
/// build the letters on the keys into the glyph cache now: the first key press is as fast as all the others
gtext_prepare(addr(s_white_labels), COLOR_DARK_GRAY);
gtext_prepare(addr(s_black_labels), COLOR_GRAY);
draw_wave();
draw_keys();
loop {
    kbd_poll();
    n = 0;
    w = 0;
    for (i of 0 .. 9) {
        if (kbd_pressed(u32(white_key[i])) == 1) {
            play(u32(white_note[i]));
            n = 1;
        }
    }
    for (i of 0 .. 7) {
        if (kbd_pressed(u32(black_key[i])) == 1) {
            play(u32(black_note[i]));
            n = 1;
        }
    }
    if (kbd_pressed(kb.KEY_ONE) == 1) {
        wave = AUDIO_SQUARE;
        w = 1;
    }
    if (kbd_pressed(kb.KEY_TWO) == 1) {
        wave = AUDIO_SINE;
        w = 1;
    }
    if (kbd_pressed(kb.KEY_THREE) == 1) {
        wave = AUDIO_TRIANGLE;
        w = 1;
    }
    if (kbd_pressed(kb.KEY_FOUR) == 1) {
        wave = AUDIO_SAW;
        w = 1;
    }
    if (w == 1) {
        draw_wave();
    }
    /// redraw the keys when a key went down or up
    if (n == 1 || kbd_count != playing) {
        draw_keys();
    }
    playing = kbd_count;
    gfx_vsync();
}
