program "paint - draw with the mouse. Left button paints, right button erases (white). Click a swatch in the palette to pick a colour, +/- change the brush size, C clears the canvas. A stroke is a chain of discs along the mouse path, so fast moves leave no gaps. (lib/gfx, lib/colors, lib/input, lib/math)";
import "../lib/gfx.obj";
import "../lib/input.obj";
import "../lib/math.obj";

const TOP = 40;
const SWATCH = 32;
const SWATCHES = 16;
const PAPER = 0xFFFFFFFF;

let palette: u32[SWATCHES];
let current: u32;
let size: i32 = 6;
let last_x: i32;
let last_y: i32;
let drawing: u32;
let i: u32;

function draw_palette() {
    let k: u32;

    gfx_fill_rect(0, 0, 640, TOP, COLOR_DARK_GRAY);
    for (k of 0 .. SWATCHES) {
        gfx_fill_rect(4 + i32(k) * (SWATCH + 4), 4, SWATCH, SWATCH, palette[k]);
        if (k == current) {
            gfx_rect(2 + i32(k) * (SWATCH + 4), 2, SWATCH + 4, SWATCH + 4, COLOR_WHITE);
        }
    }
    /// brush preview on the right
    gfx_fill_rect(600, 4, 36, 32, COLOR_GRAY);
    gfx_fill_circle(618, 20, math_min(size, 15), palette[current]);
}

function clear_canvas() {
    gfx_fill_rect(0, TOP, gfx_w, gfx_h - TOP, PAPER);
}

/// a disc; when it reaches into the palette strip the palette is repainted over it
function stamp(x: i32, y: i32, color: u32) {
    gfx_fill_circle(x, y, size, color);
    if (y - size < TOP) {
        draw_palette();
    }
}

/// a chain of discs from (x0, y0) to (x1, y1)
function stroke(x0: i32, y0: i32, x1: i32, y1: i32, color: u32) {
    let dx: i32;
    let dy: i32;
    let n: i32;
    let t: i32;
    let step: i32;

    dx = x1 - x0;
    dy = y1 - y0;
    n = math_max(math_abs(dx), math_abs(dy));
    step = math_max(size / 2, 1);
    if (n == 0) {
        stamp(x0, y0, color);
        return;
    }
    for (t of 0 .. n + 1 step 1) {
        if (t % step == 0 || t == n) {
            stamp(x0 + dx * t / n, y0 + dy * t / n, color);
        }
    }
}

for (i of 0 .. 12) {
    palette[i] = color_hue(i * 21);
}
palette[12] = COLOR_BLACK;
palette[13] = COLOR_GRAY;
palette[14] = COLOR_BROWN;
palette[15] = COLOR_WHITE;
current = 0;
mouse_mode(0);
gfx_clear(COLOR_BLACK);
clear_canvas();
draw_palette();
loop {
    kbd_poll();
    mouse_poll();
    if (kbd_pressed(kb.KEY_C) == 1) {
        clear_canvas();
    }
    if (kbd_pressed(kb.KEY_EQUAL) == 1 && size < 40) {
        size = size + 2;
        draw_palette();
    }
    if (kbd_pressed(kb.KEY_MINUS) == 1 && size > 1) {
        size = size - 2;
        draw_palette();
    }
    if (mouse_clicked() == 1 && mouse_y < TOP) {
        /// a swatch was hit?
        for (i of 0 .. SWATCHES) {
            if (mouse_in(4 + i32(i) * (SWATCH + 4), 4, SWATCH, SWATCH) == 1) {
                current = i;
                draw_palette();
            }
        }
    } else if (mouse_down(1) == 1 || mouse_down(2) == 1) {
        if (drawing == 0) {
            last_x = mouse_x;
            last_y = mouse_y;
        }
        drawing = 1;
        if (mouse_down(2) == 1) {
            stroke(last_x, last_y, mouse_x, mouse_y, PAPER);
        } else {
            stroke(last_x, last_y, mouse_x, mouse_y, palette[current]);
        }
        last_x = mouse_x;
        last_y = mouse_y;
    } else {
        drawing = 0;
    }
    gfx_vsync();
}
