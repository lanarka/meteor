module gtext;
import "gfx.obj";
import "colors.obj";
import "math.obj";

/// Text in the pixel graphics mode. The glyphs are the 8 x 16 pixel PxPlus IBM VGA font that the
/// VM uses for its own text mode (ASCII 32 .. 126), one bit per pixel, 16 bytes per glyph.
///
///   gtext(10, 10, addr(msg), COLOR_WHITE);          // transparent background
///   gtext_bg(10, 30, addr(msg), COLOR_BLACK, COLOR_YELLOW);
///   gtext_scale = 2;                                // 2x, 3x or 4x bigger letters (1 = normal)
///
/// RAM: about 130 KB together with lib/gfx (the glyph caches are 64 KB and 48 KB), so a program that imports it has to declare ram(size: 262144) - the default RAM of a program is only 32 KB.

let gtext_scale: i32 = 1;
let gtext_buf: u32[2048];
let gtext_num: u8[16];

/// Glyph caches: building a glyph from its bits costs thousands of VM instructions (about 5 000 in the normal
/// size, 20 000 at gtext_scale = 2), drawing a finished one is a single block transfer. Every glyph that is
/// drawn in the normal size or twice as big on a transparent background is remembered (per character and
/// colour, 2-way set associative), so text that is redrawn every frame is cheap after the first time - and
/// gtext_prepare() can do the first time in advance. The caches take GTEXT_SLOTS * 512 and GTEXT_BIG_SLOTS * 2048
/// bytes of RAM - lower the constants for smaller programs (they must be even). Letters in other sizes
/// (3x, 4x) and letters on a coloured background are built every time.
const GTEXT_SLOTS = 128;
const GTEXT_BIG_SLOTS = 24;

let gtext_cache: u32[GTEXT_SLOTS * 128];
let gtext_ckey_c: u8[GTEXT_SLOTS];
let gtext_ckey_fg: u32[GTEXT_SLOTS];
let gtext_evict: u32;
let gtext_big: u32[GTEXT_BIG_SLOTS * 512];
let gtext_bkey_c: u8[GTEXT_BIG_SLOTS];
let gtext_bkey_fg: u32[GTEXT_BIG_SLOTS];
