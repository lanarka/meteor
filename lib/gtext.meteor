/// draws the glyph c scaled sc times into the RGBA buffer at dst (8*sc x 16*sc pixels)
function gtext_render(dst: u32, c: u32, fg: u32, bg: u32, sc: u32) {
    let g: u32;
    let row: u32;
    let col: u32;
    let bits: u32;
    let px: u32;
    let sy: u32;
    let sx: u32;
    let cw: u32;

    cw = 8 * sc;
    g = (c - 32) * 16;
    for (row of 0 .. 16) {
        bits = u32(gtext_font[g + row]);
        for (col of 0 .. 8) {
            if ((bits >> (7 - col)) & 1 != 0) {
                px = fg;
            } else {
                px = bg;
            }
            if (sc == 1) {
                poke(dst + (row * 8 + col) * 4, u32, px);
            } else {
                for (sy of 0 .. sc) {
                    for (sx of 0 .. sc) {
                        poke(dst + ((row * sc + sy) * cw + col * sc + sx) * 4, u32, px);
                    }
                }
            }
        }
    }
}

/// the slot of a glyph cache that holds the glyph c in the colour fg, rendered at the scale sc on a miss.
/// cache = the pixels, kc / kf = the arrays with the characters and colours of the slots, bytes = size of a slot
function gtext_lookup(c: u32, fg: u32, sc: u32, cache: u32, kc: u32, kf: u32, slots: u32, bytes: u32): u32 {
    let h: u32;
    let w: u32;

    h = ((c * 7 + (fg ^ (fg >> 8) ^ (fg >> 16))) % (slots / 2)) * 2;
    if (u32(peek(kc + h, u8)) == c && peek(kf + h * 4, u32) == fg) {
        return h;
    }
    if (u32(peek(kc + h + 1, u8)) == c && peek(kf + (h + 1) * 4, u32) == fg) {
        return h + 1;
    }
    /// miss: take an empty way of the set, otherwise evict the ways in turn
    if (peek(kc + h, u8) == 0) {
        w = h;
    } else if (peek(kc + h + 1, u8) == 0) {
        w = h + 1;
    } else {
        w = h + (gtext_evict & 1);
        gtext_evict++;
    }
    gtext_render(cache + w * bytes, c, fg, 0, sc);
    poke(kc + w, u8, u8(c));
    poke(kf + w * 4, u32, fg);
    return w;
}

/// index of the slot of the normal size cache
function gtext_slot(c: u32, fg: u32): u32 {
    return gtext_lookup(c, fg, 1, addr(gtext_cache), addr(gtext_ckey_c), addr(gtext_ckey_fg), GTEXT_SLOTS, 512);
}

/// index of the slot of the cache of the double size
function gtext_slot_big(c: u32, fg: u32): u32 {
    return gtext_lookup(c, fg, 2, addr(gtext_big), addr(gtext_bkey_c), addr(gtext_bkey_fg), GTEXT_BIG_SLOTS, 2048);
}

/// Builds the glyphs of a string in the colour fg into the cache for the current gtext_scale (1 or 2) without
/// drawing anything. Call it once at the start with the characters that will be needed, and the first redraw
/// is as fast as every later one.
function gtext_prepare(s: u32, fg: u32) {
    let c: u32;
    let sc: i32;
    let slot: u32;

    sc = math_clamp(gtext_scale, 1, 4);
    c = u32(peek(s, u8));
    while (c != 0) {
        if (c < 32 || c > 126) {
            c = 63;
        }
        if (c != 32) {
            if (sc == 1) {
                slot = gtext_slot(c, fg);
            } else if (sc == 2) {
                slot = gtext_slot_big(c, fg);
            }
        }
        s++;
        c = u32(peek(s, u8));
    }
}

/// one character with its top left corner at (x, y); bg = 0 keeps the background transparent
function gtext_char(x: i32, y: i32, c: u32, fg: u32, bg: u32) {
    let sc: u32;

    if (c < 32 || c > 126) {
        c = 63;
    }
    if (c == 32 && bg == 0) {
        return;
    }
    sc = u32(math_clamp(gtext_scale, 1, 4));
    if (bg == 0 && sc == 1) {
        gfx_sprite(x, y, 8, 16, addr(gtext_cache) + gtext_slot(c, fg) * 512);
        return;
    }
    if (bg == 0 && sc == 2) {
        gfx_sprite(x, y, 16, 32, addr(gtext_big) + gtext_slot_big(c, fg) * 2048);
        return;
    }
    gtext_render(addr(gtext_buf), c, fg, bg, sc);
    gfx_sprite(x, y, i32(8 * sc), i32(16 * sc), addr(gtext_buf));
}

/// string with a background colour behind every character
function gtext_bg(x: i32, y: i32, s: u32, fg: u32, bg: u32) {
    let c: u32;
    let step: i32;

    step = 8 * math_clamp(gtext_scale, 1, 4);
    c = u32(peek(s, u8));
    while (c != 0) {
        gtext_char(x, y, c, fg, bg);
        x = x + step;
        s++;
        c = u32(peek(s, u8));
    }
}

/// zero terminated string with a transparent background
function gtext(x: i32, y: i32, s: u32, fg: u32) {
    gtext_bg(x, y, s, fg, 0);
}

/// width of a string in pixels
function gtext_width(s: u32): i32 {
    let n: i32;

    n = 0;
    while (peek(s + u32(n), u8) != 0) {
        n++;
    }
    return n * 8 * math_clamp(gtext_scale, 1, 4);
}

/// height of a line of text in pixels (16 times gtext_scale)
function gtext_height(): i32 {
    return 16 * math_clamp(gtext_scale, 1, 4);
}

/// string centered inside the pixel columns x .. x + w - 1
function gtext_center(x: i32, w: i32, y: i32, s: u32, fg: u32) {
    gtext(x + (w - gtext_width(s)) / 2, y, s, fg);
}

/// string with its right end at x (e.g. for numbers)
function gtext_right(x: i32, y: i32, s: u32, fg: u32) {
    gtext(x - gtext_width(s), y, s, fg);
}

/// formats v into gtext_num (zero terminated)
function gtext_format(v: i32) {
    let neg: u32;
    let u: u32;
    let n: u32;
    let k: u32;

    neg = 0;
    u = u32(v);
    if (v < 0) {
        neg = 1;
        u = u32(-v);
    }
    n = 0;
    do {
        gtext_num[n] = u8(u % 10 + 48);
        n++;
        u = u / 10;
    } while (u != 0);
    if (neg == 1) {
        gtext_num[n] = 45;
        n++;
    }
    /// the digits came out in reverse order
    k = 0;
    while (k < n / 2) {
        u = u32(gtext_num[k]);
        gtext_num[k] = gtext_num[n - 1 - k];
        gtext_num[n - 1 - k] = u8(u);
        k++;
    }
    gtext_num[n] = 0;
}

/// signed decimal number, left aligned at x
function gtext_int(x: i32, y: i32, v: i32, fg: u32) {
    gtext_format(v);
    gtext(x, y, addr(gtext_num), fg);
}

/// signed decimal number, right aligned at x
function gtext_int_right(x: i32, y: i32, v: i32, fg: u32) {
    gtext_format(v);
    gtext_right(x, y, addr(gtext_num), fg);
}
